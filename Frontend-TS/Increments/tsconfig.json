{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Development: Inline source maps embed TypeScript sources in JS files for debugging
    "inlineSourceMap": true,
    "inlineSources": true,
    // Production: Disable source maps to reduce file size and avoid 404 warnings
    // "sourceMap": false,
    "outDir": "wwwroot/js",
    "rootDir": "src/ts",
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/ts/**/*"
  ]
}