{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "wwwroot/js",
    "rootDir": "src/ts",
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/ts/**/*"
  ]
}