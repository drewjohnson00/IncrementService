{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=Increments;Integrated Security=True;Encrypt=Yes;TrustServerCertificate=Yes;MultipleActiveResultSets=True"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": null,
          "retainedFileTimeLimit": "14.00:00:00",
          "fileSizeLimitBytes": 1073741824,
          "outputTemplate": "{Timestamp:s} [{Level:u3}] {SourceContext}-{Message} {Properties:j}{NewLine}{Exception}",
          "rollOnFileSizeLimit": "true"
        }
      }
    ]
  },
